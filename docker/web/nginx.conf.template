# =============================================================================
#  nginx do painel
# =============================================================================
#  Este arquivo é um TEMPLATE. O entrypoint roda `envsubst` nele no arranque do
#  container, substituindo ${API_HOST} e ${API_PORT} pelos valores do ambiente.
#
#  É o que permite trocar a porta da API sem reconstruir a imagem: o front chama
#  sempre `/api` relativo, e o destino é resolvido aqui, em tempo de execução.
# =============================================================================

server {
    listen       ${WEB_INTERNAL_PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Sem isso, o nginx anuncia a própria versão em toda resposta.
    server_tokens off;

    # Cabeçalhos de segurança básicos. CSP fica de fora porque o painel usa
    # estilos gerados em tempo de execução pelo Tailwind.
    add_header X-Content-Type-Options nosniff       always;
    add_header X-Frame-Options        SAMEORIGIN    always;
    add_header Referrer-Policy        same-origin   always;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_types        text/css application/javascript application/json image/svg+xml;

    client_max_body_size ${BODY_LIMIT};

    # -------------------------------------------------------------------------
    #  API
    # -------------------------------------------------------------------------
    location /api/ {
        proxy_pass         http://${API_HOST}:${API_PORT}/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # A API confia em X-Forwarded-For (trust proxy) para registrar o IP real
        # na auditoria — sem isto, toda linha registraria o IP do container.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "";

        proxy_connect_timeout 10s;
        proxy_read_timeout    120s;
    }

    # -------------------------------------------------------------------------
    #  Server-Sent Events
    # -------------------------------------------------------------------------
    #  O buffer do nginx é a armadilha clássica de SSE: com ele ligado, o nginx
    #  segura os eventos esperando encher o buffer, e o painel recebe tudo em
    #  lote — ou nada, até a conexão cair. Precisa de bloco próprio.
    location /api/admin/events {
        proxy_pass         http://${API_HOST}:${API_PORT}/admin/events;
        proxy_http_version 1.1;

        proxy_set_header Host       $host;
        proxy_set_header Connection '';
        proxy_set_header X-Real-IP  $remote_addr;

        proxy_buffering     off;
        proxy_cache         off;
        chunked_transfer_encoding off;

        # Conexão longa por natureza: o timeout precisa ser maior que o
        # heartbeat de 25s da aplicação, com folga.
        proxy_read_timeout 24h;
    }

    # -------------------------------------------------------------------------
    #  Arquivos estáticos
    # -------------------------------------------------------------------------
    #  Os nomes têm hash do conteúdo, então podem ser cacheados agressivamente.
    location /assets/ {
        expires    1y;
        add_header Cache-Control "public, immutable";
    }

    # O index nunca é cacheado: é ele que aponta para os assets novos após um
    # deploy. Cacheá-lo serviria a versão antiga do painel indefinidamente.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Roteamento no cliente: qualquer caminho desconhecido devolve o index.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
