# =============================================================================
#  WhatsApp Gateway W51 — configuração
# =============================================================================
#  Copie para .env e rode ./scripts/gen-secrets.sh para preencher os segredos.
#  NENHUMA porta é fixa em compose, Dockerfile, nginx ou código: tudo sai daqui.
# =============================================================================

# -----------------------------------------------------------------------------
#  Portas expostas no HOST — mude à vontade se houver conflito na sua máquina
# -----------------------------------------------------------------------------
#  Atenção: estas variáveis controlam APENAS o lado do host. Entre containers o
#  acesso é sempre por nome de serviço + porta interna fixa (postgres:5432,
#  redis:6379, waha:3000), então trocar aqui não quebra nada internamente.
# painel administrativo (nginx)
WEB_PORT=8080
# gateway NestJS — esta o serviço escuta de verdade
API_PORT=3001
# Postgres
POSTGRES_PORT=5432
# Redis
REDIS_PORT=6379
# WAHA — publicado só em dev; em produção fica fechado
WAHA_PORT=3000

# Endereço de bind no host.
#   127.0.0.1 = só a própria máquina enxerga (recomendado)
#   0.0.0.0   = exposto na rede local — use com consciência
BIND_ADDRESS=127.0.0.1

# -----------------------------------------------------------------------------
#  Ambiente
# -----------------------------------------------------------------------------
NODE_ENV=development
TZ=America/Sao_Paulo
# error | warn | info | debug | trace
LOG_LEVEL=debug
# pretty (dev) | json (produção)
LOG_FORMAT=pretty

# -----------------------------------------------------------------------------
#  Postgres
# -----------------------------------------------------------------------------
#  Dois databases no mesmo servidor: "gateway" (nosso schema) e "waha" (sessões
#  do WhatsApp, gerenciadas pelo próprio WAHA). Separados para não colidirem.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
POSTGRES_DB=gateway
WAHA_POSTGRES_DB=waha

#  URL usada pela API. Em desenvolvimento a API roda no host, então aponta para
#  localhost:${POSTGRES_PORT}; dentro de container seria postgres:5432.
DATABASE_URL=postgresql://gateway:@localhost:5432/gateway?schema=public

# -----------------------------------------------------------------------------
#  Redis (filas BullMQ, cache e rate limit)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
#  WAHA
# -----------------------------------------------------------------------------
#  Imagem fixada em versão: "latest" muda debaixo dos pés e quebra deploy.
#  A tag noweb não embute Chromium — é a que corresponde ao motor NOWEB.
WAHA_IMAGE=devlikeapro/waha:noweb-2026.8.1

#  Motor sem browser: fala com o WhatsApp por WebSocket, memória muito menor.
WHATSAPP_DEFAULT_ENGINE=NOWEB

#  URL do WAHA vista pela API. Em dev a API roda no host: localhost:${WAHA_PORT}.
WAHA_BASE_URL=http://localhost:3000

#  Chave que a API usa para falar com o WAHA. Gerada pelo gen-secrets.sh.
WAHA_API_KEY=

#  Segredo global de HMAC dos webhooks WAHA -> gateway. Cada sessão ainda ganha
#  o seu próprio segredo (tarefa 09); este é o fallback.
WAHA_WEBHOOK_HMAC_KEY=

#  URL pela qual o WAHA alcança o gateway para entregar webhooks.
#  Em DEV a API roda no host e o WAHA em container, então precisa de
#  host.docker.internal (o compose já mapeia isso via extra_hosts).
#  Em PRODUÇÃO a API também é container: troque para http://api:${API_PORT}
GATEWAY_INTERNAL_URL=http://host.docker.internal:3001

#  Reinicia sessões automaticamente quando o container sobe
WHATSAPP_RESTART_ALL_SESSIONS=true
#  Imprime o QR code no log do container (útil em dev, ruído em produção)
WAHA_PRINT_QR=true
#  Painel e Swagger nativos do WAHA desligados: temos os nossos, e deixá-los
#  ligados é superfície de ataque a mais.
WAHA_DASHBOARD_ENABLED=false
WHATSAPP_SWAGGER_ENABLED=false
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
#  Nome que aparece em "Aparelhos conectados" no WhatsApp do usuário
WAHA_CLIENT_DEVICE_NAME=Gateway W51

# -----------------------------------------------------------------------------
#  Painel administrativo (usuário único — não há cadastro de usuários)
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
#  API pública
# -----------------------------------------------------------------------------
#  Prefixo das chaves emitidas: wgw_live_xxxxxxxx_<segredo>
API_KEY_PREFIX=wgw_live
#  Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
#  Tamanho máximo de corpo aceito (mídia passa por aqui)
BODY_LIMIT=25mb
#  Rate limit por API key
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
#  Swagger da nossa API
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
#  Limites e retenção
# -----------------------------------------------------------------------------
# 0 = ilimitado
MAX_SESSIONS_PER_APP=0
MAX_MEDIA_SIZE_MB=16
MAX_PAGE_SIZE=100
# segundos entre reconciliações de status
SESSION_SYNC_INTERVAL=60
# janela do timestamp contra replay
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6
# falhas seguidas antes de desativar o endpoint
WEBHOOK_FAILURE_THRESHOLD=20
AUDIT_RETENTION_DAYS=180
# permite http:// nos webhooks — só em desenvolvimento
ALLOW_INSECURE_WEBHOOKS=true
